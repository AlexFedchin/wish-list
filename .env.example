# Signing key for session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Set it in Netlify under Site configuration -> Environment variables.
JWT_SECRET=

# Optional. Gift-link pictures fall back to https://r.jina.ai when a shop blocks
# a direct fetch. Anonymous use needs no key; this only raises the rate limit.
JINA_API_KEY=

# Optional. Set to "off" to keep every gift link on this site, at the cost of
# losing previews on shops behind a bot wall.
PREVIEW_READER=
